{
  "openapi": "3.1.0",
  "info": {
    "title": "ARTEMIS Phase 1",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/state": {
      "get": {
        "summary": "Get Session State",
        "description": "Return the authoritative session snapshot for full resync. Called by the frontend when client.resync_required is received (api.md §4).",
        "operationId": "get_session_state_v1_sessions__session_id__state_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Session Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionStateResponse" }
              }
            }
          },
          "404": {
            "description": "Session not found"
          },
          "422": {
            "description": "Validation Error"
          }
        },
        "security": [{ "BearerAuth": [] }]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AgentDeltaData": {
        "properties": {
          "channel": { "title": "Channel", "type": "string" },
          "text": { "title": "Text", "type": "string" }
        },
        "required": ["channel", "text"],
        "title": "AgentDeltaData",
        "type": "object"
      },
      "AgentErrorData": {
        "properties": {
          "code": { "title": "Code", "type": "string" },
          "message": { "title": "Message", "type": "string" },
          "recoverable": { "title": "Recoverable", "type": "boolean" },
          "correlation_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "default": null,
            "title": "Correlation Id"
          }
        },
        "required": ["code", "message", "recoverable"],
        "title": "AgentErrorData",
        "type": "object"
      },
      "AgentMessageData": {
        "properties": {
          "message_id": { "title": "Message Id", "type": "string" },
          "role": { "title": "Role", "type": "string" },
          "content": { "title": "Content", "type": "string" },
          "finish_reason": { "title": "Finish Reason", "type": "string" },
          "steps_used": { "title": "Steps Used", "type": "integer" },
          "tokens": {
            "additionalProperties": { "type": "integer" },
            "title": "Tokens",
            "type": "object"
          },
          "incomplete": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }],
            "default": false,
            "title": "Incomplete"
          }
        },
        "required": ["message_id", "role", "content", "finish_reason", "steps_used", "tokens"],
        "title": "AgentMessageData",
        "type": "object"
      },
      "AssistantStateData": {
        "properties": {
          "state": { "title": "State", "type": "string" },
          "intensity": { "title": "Intensity", "type": "number" }
        },
        "required": ["state", "intensity"],
        "title": "AssistantStateData",
        "type": "object"
      },
      "ResyncRequiredData": {
        "properties": {
          "last_seq": { "title": "Last Seq", "type": "integer" }
        },
        "required": ["last_seq"],
        "title": "ResyncRequiredData",
        "type": "object"
      },
      "SessionReadyData": {
        "properties": {
          "last_seq": { "title": "Last Seq", "type": "integer" },
          "assistant_state": { "$ref": "#/components/schemas/AssistantStateData" },
          "model": { "additionalProperties": true, "title": "Model", "type": "object" },
          "pending_approvals": { "items": {}, "title": "Pending Approvals", "type": "array" }
        },
        "required": ["last_seq", "assistant_state", "model", "pending_approvals"],
        "title": "SessionReadyData",
        "type": "object"
      },
      "SessionStateResponse": {
        "description": "Authoritative session snapshot returned by GET /v1/sessions/{id}/state. Used by the frontend to fully resync after a replay gap.",
        "properties": {
          "session_id": { "title": "Session Id", "type": "string" },
          "last_seq": { "title": "Last Seq", "type": "integer" },
          "assistant_state": { "$ref": "#/components/schemas/AssistantStateData" },
          "active_run": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "default": null,
            "title": "Active Run"
          },
          "pending_approvals": {
            "items": {},
            "title": "Pending Approvals",
            "type": "array",
            "default": []
          },
          "active_task": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "default": null,
            "title": "Active Task"
          }
        },
        "required": ["session_id", "last_seq", "assistant_state"],
        "title": "SessionStateResponse",
        "type": "object"
      },
      "SystemEchoData": {
        "properties": {
          "echoed_text": { "title": "Echoed Text", "type": "string" }
        },
        "required": ["echoed_text"],
        "title": "SystemEchoData",
        "type": "object"
      },
      "WSEnvelope": {
        "properties": {
          "v": { "default": 1, "title": "V", "type": "integer" },
          "seq": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }],
            "default": null,
            "title": "Seq"
          },
          "ts": { "title": "Ts", "type": "string" },
          "type": { "title": "Type", "type": "string" },
          "session_id": { "title": "Session Id", "type": "string" },
          "run_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "default": null,
            "title": "Run Id"
          },
          "data": { "additionalProperties": true, "title": "Data", "type": "object" }
        },
        "required": ["ts", "type", "session_id", "data"],
        "title": "WSEnvelope",
        "type": "object"
      }
    }
  }
}